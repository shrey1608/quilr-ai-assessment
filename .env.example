# Generate your local secret as shown in README.md. Never commit .env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=quilr-assessment
JWT_AUDIENCE=quilr-gateway
DATABASE_PATH=data/gateway.sqlite3
TOKENS_PER_MINUTE=50000
MCP_UPSTREAM_URL=http://127.0.0.1:8001/mcp
PRIMARY_URL=http://127.0.0.1:8001/primary/chat/completions
SECONDARY_URL=http://127.0.0.1:8001/secondary/chat/completions
PRIMARY_MODEL=mock-primary
SECONDARY_MODEL=mock-secondary
PRIMARY_API_KEY=
SECONDARY_API_KEY=
PROVIDER_TIMEOUT_SECONDS=3.0
